# Mujeeb AI — Environment Configuration
#
# Copy this file to `.env.local` for local development (it is gitignored).
# In production set these through Vercel's Environment Variables UI, scoped
# per environment (Development / Preview / Production) — see README.md.
#
# Run `npm run check-env` at any time: it reports which providers are
# configured and, for each one that is not, exactly what stops working.
# It never prints a value.

# =======================================================================
# REQUIRED — the app cannot function without these
# =======================================================================

# -----------------------------------------------------------------------
# Supabase — database, authentication and storage.
# Project Settings -> API in the Supabase dashboard.
# -----------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-only. Bypasses Row Level Security, so it is the most sensitive
# value here: it is required for registration, quota enforcement, admin
# actions, webhook processing and scripts/super-admin.ts.
# NEVER expose it to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# -----------------------------------------------------------------------
# Site — used to build the links inside auth emails, so it must match the
# origin users actually browse to.
# -----------------------------------------------------------------------
# Production: https://mujeebai.yungswag.xyz  (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Mujeeb AI"

# -----------------------------------------------------------------------
# Resend — transactional email.
#
# REQUIRED for registration to work for anyone outside your Supabase
# project team. Supabase's built-in SMTP only delivers to project members
# and rate-limits hard; when it refuses, GoTrue returns HTTP 500 and rolls
# the whole sign-up back, so no account is created at all. Mujeeb AI sends
# its own verification, reset and magic-link mail through Resend instead
# (see src/auth/registration.ts).
#
# The sending domain must be verified in Resend before mail will deliver.
# -----------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Mujeeb AI <noreply@your-domain.com>"

# =======================================================================
# OPTIONAL — each feature degrades with a clear message when unset
# =======================================================================

# -----------------------------------------------------------------------
# OpenRouter — chat and vision. Without this, chat cannot reach a model.
# -----------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Sent as OpenRouter's attribution headers (HTTP-Referer, X-Title).
OPENROUTER_SITE_URL=https://your-domain.com
OPENROUTER_APP_NAME="Mujeeb AI"

# -----------------------------------------------------------------------
# Cloudflare Workers AI — image generation. Without it, image generation
# returns a "not configured" error and the composer hides the control.
# -----------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# -----------------------------------------------------------------------
# Paystack — subscription billing. Without it, checkout reports that
# payments are not enabled and the app stays usable on the free plan.
# -----------------------------------------------------------------------
#
# Live keys start sk_live_ / pk_live_. Two things to know before switching:
#
#  1. Paystack rejects any currency your merchant profile has not enabled,
#     with a 403 "Currency not supported by merchant". This account's live
#     profile supports NGN only, so the `billing_currency` setting is NGN
#     and each plan needs a matching NGN entry in `currency_prices`.
#     Change the currency at /admin/settings, not here — checkout refuses
#     outright rather than charging a USD figure labelled as something
#     else.
#  2. Never paste a live secret key into a chat, an issue, or a commit.
#     If one is exposed, rotate it immediately: Paystack dashboard ->
#     Settings -> API Keys & Webhooks -> Generate new secret key.
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
# Paystack signs webhooks with your SECRET KEY — its dashboard does not
# issue a separate webhook secret. Leave this unset unless you have a
# reason to override; the app falls back to PAYSTACK_SECRET_KEY.
# PAYSTACK_WEBHOOK_SECRET=

# =======================================================================
# OPERATIONS
# =======================================================================

# -----------------------------------------------------------------------
# Super Admin bootstrap — required by scripts/super-admin.ts, which
# refuses to run without it. Generate your own and rotate after use:
#   openssl rand -hex 32
# -----------------------------------------------------------------------
SUPER_ADMIN_SETUP_TOKEN=generate-with-openssl-rand-hex-32

# Swappable adapters. Leave unset for the defaults.
# STORAGE_PROVIDER=supabase
# EMAIL_PROVIDER=resend

NODE_ENV=development

# -----------------------------------------------------------------------
# Staff portal secret path (optional, recommended in production)
# -----------------------------------------------------------------------
# Moves the admin/moderator console off the guessable /admin URL. With
# this set, the console answers ONLY at /{locale}/{slug}/admin/... and the
# bare /admin returns 404 — indistinguishable from a route that does not
# exist, so probing reveals nothing.
#
# This is obscurity, not authentication: roles, the MFA gate and the
# permission matrix are the boundary and are unchanged by it. What it buys
# is that the console is not enumerable, which is what makes putting
# Cloudflare Access in front of the same path worthwhile.
#
# Server-only by design. There is deliberately no NEXT_PUBLIC_ version:
# that would inline the value into JavaScript served to every visitor.
#
# Format: one path segment, [A-Za-z0-9_-], 1-64 chars. An invalid value is
# ignored (the console stays at /admin) rather than locking you out.
# Read at runtime, not compiled in (verified: the value appears nowhere
# in a production build), so rotating it is an env change plus a restart.
#
# Generate one: openssl rand -hex 12
# STAFF_PORTAL_SLUG=
#
# The super admin console gets its OWN secret, so that a moderator — who
# necessarily learns their own URL by using it — does not thereby learn
# the administrator console's address. If unset, STAFF_PORTAL_SLUG covers
# both. Sign-in (/staff/login) is reachable under either.
# ADMIN_PORTAL_SLUG=
