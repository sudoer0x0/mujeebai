{
  "name": "mujeeb-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/dev-guard.mjs && rm -rf .next-dev && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/unit/**/*.test.ts",
    "check-env": "tsx scripts/check-env.ts",
    "db:types:check": "tsx scripts/check-db-types.ts",
    "check-i18n": "tsx scripts/check-i18n.ts",
    "super-admin": "tsx scripts/super-admin.ts",
    "verify": "npm run typecheck && npm run lint && npm run check-i18n && npm run test && npm run build",
    "smoke:staff": "tsx --conditions=react-server --env-file=.env.local scripts/smoke-staff-routes.ts",
    "predev": "node scripts/dev-guard.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.34.0",
    "mammoth": "^1.12.1",
    "nanoid": "^6.0.1",
    "next": "15.5.24",
    "next-intl": "^4.14.0",
    "pdf-parse": "^2.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.24.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
